# GLM vision inference API key from Zhipu AI.
export ZHIPU_API_KEY="YOUR_ZHIPU_API_KEY"

# Bearer token configured by your local Mobilerun Portal instance.
export MOBILERUN_TOKEN="YOUR_MOBILERUN_TOKEN"

# Generate this locally and enter the same value in Lucid Dream Settings.
export LUCID_AGENT_TOKEN="GENERATE_YOUR_OWN_RANDOM_TOKEN"
